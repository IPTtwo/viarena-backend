NODE_ENV=development
PORT=5000
TRUST_PROXY_HOPS=0
MONGODB_URI=mongodb://127.0.0.1:27017/viarena?replicaSet=rs0
CLIENT_ORIGIN=http://localhost:5173
COOKIE_NAME=viarena_session
SESSION_DAYS=7
SCHOOL_EMAIL_DOMAIN=adnu.edu.ph
# Required for production; at least 32 random characters
SESSION_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
# Optional SMTP integration is NOT included: in development reset links are logged to the server console.
RESET_BASE_URL=http://localhost:5173/reset-password
